# Copie este arquivo para .env e ajuste

# Login do painel (OBRIGATÓRIO trocar a senha num servidor)
PANEL_USER=admin
PANEL_PASSWORD=troque-esta-senha

# (Nota mínima, segundos antes/depois, hashtags e título no vídeo agora se mudam pelo painel, em "Ajustes")

# Nota mínima (0-10) para virar corte automático.
# Muitos cortes ruins? aumente (ex: 7.5). Poucos cortes? diminua (ex: 5.5)
MIN_SCORE=6.5

# Segundos antes e depois do pico que entram no corte
CLIP_BEFORE=25
CLIP_AFTER=12

# Tempo mínimo entre dois cortes automáticos da mesma live (segundos)
COOLDOWN_SECONDS=90

# Quantos minutos de cada live ficam guardados no disco (só serve pro corte automático e o "Cortar agora"; menos = menos HD)
BUFFER_MINUTES=20

# Qualidade da gravação (a primeira disponível é usada)
QUALITY=1080p60,1080p,720p60,720p,best


# ---- Usar em 2 computadores (ver LEIA-ME) ----
# Pasta compartilhada no Google Drive: lista de canais e cortes iguais nos dois PCs
# DATA_DIR=G:\Meu Drive\cortes-gta
# Gravações temporárias ficam no disco do próprio PC (não sincroniza vídeo bruto)
# SEGMENTS_DIR=C:\cortes-gravacoes
